{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sushi",
  "version": "0.1.0",
  "identifier": "io.sushi.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html?view=pet",
        "title": "Sushi",
        "width": 300,
        "height": 96,
        "minWidth": 300,
        "maxWidth": 300,
        "minHeight": 96,
        "maxHeight": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "panel",
        "url": "index.html?view=panel",
        "title": "Sushi",
        "width": 900,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "create": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
